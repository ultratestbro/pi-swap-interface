{
  "name": "@cp0x/pi-swap-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "cp0x Swap: a permissionless swap and bridge interface. Any Wallet Kit providers run in the browser, the user's wallet signs, no backend.",
  "homepage": "https://swap.cp0x.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultratestbro/pi-swap-interface.git"
  },
  "bugs": "https://github.com/ultratestbro/pi-swap-interface/issues",
  "bin": {
    "pi-swap-interface": "bin/cli.mjs"
  },
  "files": [
    "bin/*.mjs",
    "bin/*.d.mts",
    "dist/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "guard:dist": "node .github/scripts/guard-dist.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "check-ts": "tsc -b --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepack": "pnpm build && node .github/scripts/guard-dist.mjs dist --no-api"
  },
  "dependencies": {
    "@anywalletkit/core": "0.9.0",
    "@anywalletkit/protocol-approvals-evm": "0.6.1",
    "@anywalletkit/protocol-swap2-0x": "0.1.5",
    "@anywalletkit/protocol-swap2-across": "0.1.4",
    "@anywalletkit/protocol-swap2-balancer": "0.3.13",
    "@anywalletkit/protocol-swap2-cctp": "0.6.1",
    "@anywalletkit/protocol-swap2-chainflip": "0.4.13",
    "@anywalletkit/protocol-swap2-core": "0.17.0",
    "@anywalletkit/protocol-swap2-cow": "0.1.0",
    "@anywalletkit/protocol-swap2-curve": "0.1.10",
    "@anywalletkit/protocol-swap2-fynd": "0.3.3",
    "@anywalletkit/protocol-swap2-jupiter": "0.3.14",
    "@anywalletkit/protocol-swap2-kyberswap": "0.1.0",
    "@anywalletkit/protocol-swap2-lifi": "0.8.7",
    "@anywalletkit/protocol-swap2-near-intents": "0.3.11",
    "@anywalletkit/protocol-swap2-omniston": "0.5.13",
    "@anywalletkit/protocol-swap2-relay": "0.1.8",
    "@anywalletkit/protocol-swap2-router": "0.8.0",
    "@anywalletkit/protocol-swap2-stargate": "0.1.3",
    "@anywalletkit/protocol-swap2-symbiosis": "0.1.8",
    "@anywalletkit/protocol-swap2-thorchain": "0.4.7",
    "@anywalletkit/protocol-swap2-uniswap": "0.4.11",
    "@anywalletkit/protocol-swap2-usdt0": "0.5.7",
    "@anywalletkit/protocol-swap2-wrap": "0.4.8",
    "@anywalletkit/swap2-assets": "0.3.0",
    "@anywalletkit/wallet-evm": "0.8.1",
    "@anywalletkit/wallet-solana": "0.6.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@solana/kit": "8.6.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.22",
    "@ton/core": "0.63.1",
    "@tonconnect/sdk": "3.4.1",
    "@tonconnect/ui": "2.4.4",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@walletconnect/ethereum-provider": "2.26.0",
    "buffer": "6.0.3",
    "idb-keyval": "6.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3",
    "vaul": "1.1.2",
    "viem": "2.57.10",
    "wagmi": "3.7.11",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
